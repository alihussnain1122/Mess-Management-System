@page
@model MessManagement.Areas.User.Pages.BillDetailsModel
@{
    ViewData["Title"] = "Bill Details";
}

<div class="mb-6">
    <div class="flex items-center gap-2 mb-2">
        <a href="/User/MyBill?month=@Model.SelectedMonth&year=@Model.SelectedYear" class="text-emerald-400 hover:text-emerald-300 transition-colors">
            <i class="fas fa-arrow-left mr-1"></i>Back to Bill Summary
        </a>
    </div>
    <h1 class="text-2xl font-bold text-white">Detailed Bill Breakdown</h1>
    <p class="text-white/60">View your bill by day, single date, or specific meal type</p>
</div>

<!-- Filter Controls -->
<div class="bg-white/15 backdrop-blur-xl rounded-2xl border border-white/20 p-4 mb-6">
    <form method="get" class="flex flex-wrap items-end gap-4">
        <div>
            <label class="block text-sm text-emerald-400 mb-1">Month</label>
            <select name="month" class="bg-white/10 border border-white/20 rounded-xl px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i" selected="@(Model.SelectedMonth == i)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm text-emerald-400 mb-1">Year</label>
            <select name="year" class="bg-white/10 border border-white/20 rounded-xl px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 2; y--)
                {
                    <option value="@y" selected="@(Model.SelectedYear == y)">@y</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm text-emerald-400 mb-1">Specific Date (Optional)</label>
            <input type="date" name="date" value="@Model.SelectedDate?.ToString("yyyy-MM-dd")" 
                   class="bg-white/10 border border-white/20 rounded-xl px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500" />
        </div>
        <div>
            <label class="block text-sm text-emerald-400 mb-1">Meal Type</label>
            <select name="meal" class="bg-white/10 border border-white/20 rounded-xl px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                <option value="all" selected="@(Model.MealFilter == "all")">🍴 All Meals</option>
                <option value="breakfast" selected="@(Model.MealFilter == "breakfast")">🍳 Breakfast Only</option>
                <option value="lunch" selected="@(Model.MealFilter == "lunch")">🍛 Lunch Only</option>
                <option value="dinner" selected="@(Model.MealFilter == "dinner")">🍽️ Dinner Only</option>
            </select>
        </div>
        <button type="submit" class="bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white px-4 py-2 rounded-xl transition-all shadow-lg">
            <i class="fas fa-filter mr-2"></i>Apply Filter
        </button>
        @if (Model.SelectedDate.HasValue || Model.MealFilter != "all")
        {
            <a href="/User/BillDetails?month=@Model.SelectedMonth&year=@Model.SelectedYear" 
               class="bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-xl transition-all border border-white/20">
                <i class="fas fa-times mr-2"></i>Clear Filters
            </a>
        }
    </form>
</div>

<!-- Current Filter Info -->
<div class="flex flex-wrap items-center gap-2 mb-6">
    <span class="text-white/60 text-sm">Showing:</span>
    @if (Model.SelectedDate.HasValue)
    {
        <span class="bg-purple-500/20 text-purple-400 px-3 py-1 rounded-full text-sm border border-purple-500/30">
            <i class="fas fa-calendar-day mr-1"></i>@Model.SelectedDate.Value.ToString("MMM dd, yyyy")
        </span>
    }
    else
    {
        <span class="bg-blue-500/20 text-blue-400 px-3 py-1 rounded-full text-sm border border-blue-500/30">
            <i class="fas fa-calendar mr-1"></i>@Model.MonthName @Model.SelectedYear
        </span>
    }
    @if (Model.MealFilter != "all")
    {
        <span class="bg-amber-500/20 text-amber-400 px-3 py-1 rounded-full text-sm border border-amber-500/30">
            @switch (Model.MealFilter)
            {
                case "breakfast":
                    <text>🍳 Breakfast Only</text>
                    break;
                case "lunch":
                    <text>🍛 Lunch Only</text>
                    break;
                case "dinner":
                    <text>🍽️ Dinner Only</text>
                    break;
            }
        </span>
    }
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="bg-gradient-to-br from-purple-600/80 to-indigo-700/80 rounded-2xl p-4 border border-white/20">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-white/60 text-sm">Total Days</p>
                <p class="text-2xl font-bold text-white">@Model.TotalDays</p>
            </div>
            <div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center">
                <i class="fas fa-calendar-check text-purple-300 text-xl"></i>
            </div>
        </div>
    </div>
    <div class="bg-gradient-to-br from-blue-600/80 to-cyan-700/80 rounded-2xl p-4 border border-white/20">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-white/60 text-sm">Total Meals</p>
                <p class="text-2xl font-bold text-white">@Model.TotalMeals</p>
            </div>
            <div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center">
                <i class="fas fa-utensils text-blue-300 text-xl"></i>
            </div>
        </div>
    </div>
    <div class="bg-gradient-to-br from-emerald-600/80 to-teal-700/80 rounded-2xl p-4 border border-white/20">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-white/60 text-sm">Total Charges</p>
                <p class="text-2xl font-bold text-white">Rs. @Model.TotalCharges.ToString("N2")</p>
            </div>
            <div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center">
                <i class="fas fa-rupee-sign text-emerald-300 text-xl"></i>
            </div>
        </div>
    </div>
</div>

@if (Model.SingleDayData != null)
{
    <!-- Single Day Detailed View -->
    <div class="bg-white/15 backdrop-blur-xl rounded-2xl border border-white/20 overflow-hidden mb-6">
        <div class="bg-gradient-to-r from-purple-500/20 to-pink-500/20 px-6 py-4 border-b border-white/20">
            <h3 class="font-semibold text-white text-lg">
                <i class="fas fa-receipt mr-2 text-purple-400"></i>
                Bill for @Model.SingleDayData.Date.ToString("dddd, MMMM dd, yyyy")
            </h3>
        </div>
        <div class="p-6">
            <!-- Meals Breakdown -->
            <div class="space-y-4 mb-6">
                @foreach (var meal in Model.SingleDayData.Meals)
                {
                    <div class="bg-white/5 rounded-xl p-4 border border-white/10">
                        <div class="flex items-start justify-between">
                            <div class="flex items-start gap-4">
                                <div class="w-14 h-14 bg-gradient-to-br @GetMealGradient(meal.MealType) rounded-xl flex items-center justify-center text-2xl">
                                    @meal.MealIcon
                                </div>
                                <div>
                                    <h4 class="text-white font-semibold text-lg">@meal.MealType</h4>
                                    <p class="text-white/80">@meal.DishName</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-white/60 text-sm">
                                    Meal: <span class="text-white">Rs.@meal.MealPrice.ToString("N0")</span>
                                </div>
                                <div class="text-white/60 text-sm">
                                    Tea: <span class="text-amber-400">Rs.@meal.TeaPrice.ToString("N0")</span>
                                </div>
                                <div class="text-white/60 text-sm">
                                    Water: <span class="text-cyan-400">FREE</span>
                                </div>
                                <div class="mt-2 pt-2 border-t border-white/10">
                                    <span class="text-lg font-bold text-emerald-400">Rs.@meal.TotalPrice.ToString("N0")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Day Total Summary -->
            <div class="bg-gradient-to-r from-emerald-500/10 to-teal-500/10 rounded-xl p-4 border border-emerald-500/20">
                <table class="w-full">
                    <tbody>
                        <tr>
                            <td class="py-2 text-white/70">Meal Charges</td>
                            <td class="py-2 text-right text-white font-medium">Rs.@Model.SingleDayData.MealTotal.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="py-2 text-white/70">Tea/Coffee Charges</td>
                            <td class="py-2 text-right text-amber-400 font-medium">Rs.@Model.SingleDayData.TeaTotal.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="py-2 text-white/70">Water</td>
                            <td class="py-2 text-right text-cyan-400 font-medium">FREE</td>
                        </tr>
                        <tr class="border-t border-white/20">
                            <td class="py-3 text-white font-semibold text-lg">Day Total</td>
                            <td class="py-3 text-right text-emerald-400 font-bold text-xl">Rs.@Model.SingleDayData.GrandTotal.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (Model.DailyRecords.Any())
{
    <!-- Daily Records List -->
    <div class="bg-white/15 backdrop-blur-xl rounded-2xl border border-white/20 overflow-hidden">
        <div class="bg-gradient-to-r from-amber-500/20 to-orange-500/20 px-6 py-4 border-b border-white/20">
            <h3 class="font-semibold text-white">
                <i class="fas fa-list-alt mr-2 text-amber-400"></i>Daily Bill Records
            </h3>
            <p class="text-white/60 text-sm mt-1">Click on a date to view detailed breakdown</p>
        </div>
        <div class="divide-y divide-white/10">
            @foreach (var day in Model.DailyRecords)
            {
                <div class="p-4 hover:bg-white/5 transition-colors">
                    <!-- Day Header - Clickable -->
                    <a href="/User/BillDetails?month=@Model.SelectedMonth&year=@Model.SelectedYear&date=@day.Date.ToString("yyyy-MM-dd")&meal=@Model.MealFilter" 
                       class="flex items-center justify-between cursor-pointer group">
                        <div class="flex items-center gap-4">
                            <div class="w-14 h-14 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex flex-col items-center justify-center">
                                <span class="text-white font-bold text-lg">@day.Date.Day</span>
                                <span class="text-white/70 text-xs">@day.Date.ToString("MMM")</span>
                            </div>
                            <div>
                                <h4 class="text-white font-medium group-hover:text-emerald-400 transition-colors">
                                    @day.DayName
                                    <i class="fas fa-chevron-right ml-2 text-white/30 group-hover:text-emerald-400 transition-colors text-sm"></i>
                                </h4>
                                <p class="text-white/60 text-sm">@day.MealCount meal(s)</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-emerald-400 font-bold text-lg">Rs.@day.DayGrandTotal.ToString("N0")</p>
                            <p class="text-white/50 text-xs">Click for details</p>
                        </div>
                    </a>
                    
                    <!-- Meals Preview -->
                    <div class="mt-3 ml-[72px] flex flex-wrap gap-2">
                        @foreach (var meal in day.Meals)
                        {
                            <div class="bg-white/5 rounded-lg px-3 py-2 flex items-center gap-2 border border-white/10">
                                <span>@meal.MealIcon</span>
                                <div>
                                    <span class="text-white/80 text-sm">@meal.DishName</span>
                                    <span class="text-emerald-400 text-xs ml-2">Rs.@meal.TotalPrice.ToString("N0")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        
        <!-- Total Footer -->
        <div class="bg-gradient-to-r from-emerald-500/10 to-teal-500/10 px-6 py-4 border-t border-white/20">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-white/70 text-sm">Total for selected period</p>
                    <p class="text-white text-sm">@Model.TotalDays days • @Model.TotalMeals meals</p>
                </div>
                <div class="text-right">
                    <p class="text-white/60 text-sm">Grand Total</p>
                    <p class="text-emerald-400 font-bold text-2xl">Rs.@Model.TotalCharges.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- No Records -->
    <div class="bg-white/15 backdrop-blur-xl rounded-2xl border border-white/20 p-12 text-center">
        <div class="w-20 h-20 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-calendar-times text-white/30 text-3xl"></i>
        </div>
        <h3 class="text-white text-lg font-medium mb-2">No Records Found</h3>
        <p class="text-white/60 mb-4">No meal records match your selected filters.</p>
        <a href="/User/BillDetails?month=@Model.SelectedMonth&year=@Model.SelectedYear" 
           class="inline-block bg-gradient-to-r from-emerald-500 to-teal-500 text-white px-6 py-2 rounded-xl">
            <i class="fas fa-refresh mr-2"></i>Reset Filters
        </a>
    </div>
}



@functions {
    string GetMealGradient(string mealType)
    {
        return mealType switch
        {
            "Breakfast" => "from-amber-500 to-orange-500",
            "Lunch" => "from-blue-500 to-indigo-500",
            "Dinner" => "from-purple-500 to-pink-500",
            _ => "from-gray-500 to-gray-600"
        };
    }
}

<style>
    select option {
        background-color: #1f2937;
        color: white;
    }
    input[type="date"]::-webkit-calendar-picker-indicator {
        filter: invert(1);
    }
</style>
