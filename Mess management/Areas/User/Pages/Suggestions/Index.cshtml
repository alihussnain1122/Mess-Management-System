@page
@model MessManagement.Areas.User.Pages.Suggestions.IndexModel
@{
    ViewData["Title"] = "My Suggestions";
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-white">My Suggestions & Feedback</h1>
        <p class="text-white/60">Send suggestions, complaints, or feedback to the admin</p>
    </div>
    <a href="/User/Suggestions/Create" 
       class="bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white px-4 py-2 rounded-xl transition-all shadow-lg flex items-center">
        <i class="fas fa-plus mr-2"></i>New Suggestion
    </a>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="bg-gradient-to-br from-blue-600/80 to-indigo-700/80 rounded-2xl p-4 border border-white/20">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-white/60 text-sm">Total Submitted</p>
                <p class="text-2xl font-bold text-white">@Model.TotalCount</p>
            </div>
            <div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center">
                <i class="fas fa-envelope text-blue-300 text-xl"></i>
            </div>
        </div>
    </div>
    <div class="bg-gradient-to-br from-amber-600/80 to-orange-700/80 rounded-2xl p-4 border border-white/20">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-white/60 text-sm">Pending</p>
                <p class="text-2xl font-bold text-white">@Model.PendingCount</p>
            </div>
            <div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center">
                <i class="fas fa-clock text-amber-300 text-xl"></i>
            </div>
        </div>
    </div>
    <div class="bg-gradient-to-br from-emerald-600/80 to-teal-700/80 rounded-2xl p-4 border border-white/20">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-white/60 text-sm">Resolved</p>
                <p class="text-2xl font-bold text-white">@Model.ResolvedCount</p>
            </div>
            <div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center">
                <i class="fas fa-check-circle text-emerald-300 text-xl"></i>
            </div>
        </div>
    </div>
</div>

<!-- Suggestions List -->
<div class="bg-white/15 backdrop-blur-xl rounded-2xl border border-white/20 overflow-hidden">
    <div class="bg-white/10 px-6 py-4 border-b border-white/20">
        <h3 class="font-semibold text-white">
            <i class="fas fa-list mr-2 text-emerald-400"></i>My Submissions
        </h3>
    </div>
    
    @if (Model.MySuggestions.Any())
    {
        <div class="divide-y divide-white/10">
            @foreach (var suggestion in Model.MySuggestions)
            {
                <div class="p-4 hover:bg-white/5 transition-colors">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="px-2 py-1 rounded-lg text-xs font-medium @GetCategoryColor(suggestion.Category)">
                                    @GetCategoryIcon(suggestion.Category) @suggestion.Category
                                </span>
                                <span class="px-2 py-1 rounded-lg text-xs font-medium @GetStatusColor(suggestion.Status)">
                                    @suggestion.Status
                                </span>
                                @if (suggestion.IsAnonymous)
                                {
                                    <span class="px-2 py-1 rounded-lg text-xs font-medium bg-purple-500/20 text-purple-400 border border-purple-500/30">
                                        <i class="fas fa-user-secret mr-1"></i>Anonymous
                                    </span>
                                }
                            </div>
                            <h4 class="text-white font-medium mb-1">@suggestion.Subject</h4>
                            <p class="text-white/60 text-sm line-clamp-2">@suggestion.Message</p>
                            <p class="text-white/40 text-xs mt-2">
                                <i class="fas fa-clock mr-1"></i>Submitted on @suggestion.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
                            </p>
                        </div>
                        <a href="/User/Suggestions/Details/@suggestion.SuggestionId" 
                           class="bg-purple-500/20 hover:bg-purple-500/40 text-purple-400 px-3 py-2 rounded-lg text-sm font-medium transition-all flex items-center">
                            <i class="fas fa-eye mr-1"></i>View
                        </a>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(suggestion.AdminResponse))
                    {
                        <div class="mt-3 ml-4 p-3 bg-emerald-500/10 rounded-lg border border-emerald-500/20">
                            <p class="text-emerald-400 text-xs font-medium mb-1">
                                <i class="fas fa-reply mr-1"></i>Admin Response
                            </p>
                            <p class="text-white/80 text-sm line-clamp-2">@suggestion.AdminResponse</p>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="p-12 text-center">
            <div class="w-20 h-20 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-inbox text-white/30 text-3xl"></i>
            </div>
            <h3 class="text-white text-lg font-medium mb-2">No Suggestions Yet</h3>
            <p class="text-white/60 mb-4">You haven't submitted any suggestions or feedback.</p>
            <a href="/User/Suggestions/Create" 
               class="inline-block bg-gradient-to-r from-emerald-500 to-teal-500 text-white px-6 py-2 rounded-xl">
                <i class="fas fa-plus mr-2"></i>Submit Your First Suggestion
            </a>
        </div>
    }
</div>

@functions {
    string GetCategoryColor(MessManagement.Models.SuggestionCategory category)
    {
        return category switch
        {
            MessManagement.Models.SuggestionCategory.Menu => "bg-amber-500/20 text-amber-400 border border-amber-500/30",
            MessManagement.Models.SuggestionCategory.Quality => "bg-blue-500/20 text-blue-400 border border-blue-500/30",
            MessManagement.Models.SuggestionCategory.Service => "bg-cyan-500/20 text-cyan-400 border border-cyan-500/30",
            MessManagement.Models.SuggestionCategory.Hygiene => "bg-green-500/20 text-green-400 border border-green-500/30",
            MessManagement.Models.SuggestionCategory.Pricing => "bg-pink-500/20 text-pink-400 border border-pink-500/30",
            MessManagement.Models.SuggestionCategory.Complaint => "bg-red-500/20 text-red-400 border border-red-500/30",
            MessManagement.Models.SuggestionCategory.Appreciation => "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30",
            _ => "bg-white/10 text-white/70 border border-white/20"
        };
    }

    string GetCategoryIcon(MessManagement.Models.SuggestionCategory category)
    {
        return category switch
        {
            MessManagement.Models.SuggestionCategory.Menu => "🍽️",
            MessManagement.Models.SuggestionCategory.Quality => "⭐",
            MessManagement.Models.SuggestionCategory.Service => "🛎️",
            MessManagement.Models.SuggestionCategory.Hygiene => "🧹",
            MessManagement.Models.SuggestionCategory.Pricing => "💰",
            MessManagement.Models.SuggestionCategory.Complaint => "⚠️",
            MessManagement.Models.SuggestionCategory.Appreciation => "❤️",
            MessManagement.Models.SuggestionCategory.Timing => "⏰",
            MessManagement.Models.SuggestionCategory.Staff => "👥",
            _ => "💬"
        };
    }

    string GetStatusColor(MessManagement.Models.SuggestionStatus status)
    {
        return status switch
        {
            MessManagement.Models.SuggestionStatus.Pending => "bg-yellow-500/20 text-yellow-400 border border-yellow-500/30",
            MessManagement.Models.SuggestionStatus.UnderReview => "bg-blue-500/20 text-blue-400 border border-blue-500/30",
            MessManagement.Models.SuggestionStatus.Resolved => "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30",
            MessManagement.Models.SuggestionStatus.Rejected => "bg-red-500/20 text-red-400 border border-red-500/30",
            MessManagement.Models.SuggestionStatus.Implemented => "bg-purple-500/20 text-purple-400 border border-purple-500/30",
            _ => "bg-white/10 text-white/70 border border-white/20"
        };
    }
}
