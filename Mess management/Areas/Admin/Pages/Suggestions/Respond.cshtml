@page "{id:int}"
@model MessManagement.Areas.Admin.Pages.Suggestions.RespondModel
@{
    ViewData["Title"] = "Respond to Suggestion";
}

<div class="mb-6">
    <div class="flex items-center gap-2 mb-2">
        <a href="/Admin/Suggestions" class="text-emerald-400 hover:text-emerald-300 transition-colors">
            <i class="fas fa-arrow-left mr-1"></i>Back to Suggestions
        </a>
    </div>
    <h1 class="text-2xl font-bold text-white">Respond to Suggestion</h1>
    <p class="text-white/60">Review the member's feedback and send your response</p>
</div>

@if (Model.Suggestion != null)
{
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Member's Suggestion -->
        <div class="bg-white/15 backdrop-blur-xl rounded-2xl border border-white/20 overflow-hidden">
            <div class="bg-white/10 px-6 py-4 border-b border-white/20">
                <h3 class="font-semibold text-white">
                    <i class="fas fa-envelope-open mr-2 text-blue-400"></i>Member's Suggestion
                </h3>
            </div>
            <div class="p-6">
                <!-- Member Info -->
                @if (!Model.Suggestion.IsAnonymous && Model.Suggestion.Member != null)
                {
                    <div class="flex items-center gap-3 mb-4 p-3 bg-white/5 rounded-xl">
                        <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-teal-500 rounded-full flex items-center justify-center text-white font-bold">
                            @Model.Suggestion.Member.FullName.Substring(0, 1).ToUpper()
                        </div>
                        <div>
                            <p class="text-white font-medium">@Model.Suggestion.Member.FullName</p>
                            <p class="text-white/60 text-sm">Room @Model.Suggestion.Member.RoomNumber</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-3 mb-4 p-3 bg-purple-500/10 rounded-xl border border-purple-500/20">
                        <div class="w-12 h-12 bg-purple-500/20 rounded-full flex items-center justify-center">
                            <i class="fas fa-user-secret text-purple-400 text-xl"></i>
                        </div>
                        <div>
                            <p class="text-purple-400 font-medium">Anonymous Submission</p>
                            <p class="text-white/60 text-sm">Member identity is hidden</p>
                        </div>
                    </div>
                }

                <!-- Category & Status -->
                <div class="flex items-center gap-2 mb-4">
                    <span class="px-3 py-1 rounded-lg text-sm font-medium @GetCategoryColor(Model.Suggestion.Category)">
                        @GetCategoryIcon(Model.Suggestion.Category) @Model.Suggestion.Category
                    </span>
                    <span class="px-3 py-1 rounded-lg text-sm font-medium @GetStatusColor(Model.Suggestion.Status)">
                        @Model.Suggestion.Status
                    </span>
                </div>

                <!-- Subject -->
                <div class="mb-4">
                    <p class="text-emerald-400 text-sm font-medium mb-1">Subject</p>
                    <h4 class="text-white text-lg font-semibold">@Model.Suggestion.Subject</h4>
                </div>

                <!-- Message -->
                <div class="mb-4">
                    <p class="text-emerald-400 text-sm font-medium mb-1">Message</p>
                    <div class="bg-white/5 rounded-xl p-4 border border-white/10">
                        <p class="text-white/90 whitespace-pre-wrap">@Model.Suggestion.Message</p>
                    </div>
                </div>

                <!-- Submitted Date -->
                <div class="text-white/50 text-sm">
                    <i class="fas fa-clock mr-1"></i>Submitted on @Model.Suggestion.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
                </div>
            </div>
        </div>

        <!-- Response Form -->
        <div class="bg-white/15 backdrop-blur-xl rounded-2xl border border-white/20 overflow-hidden">
            <div class="bg-gradient-to-r from-emerald-500/20 to-teal-500/20 px-6 py-4 border-b border-white/20">
                <h3 class="font-semibold text-white">
                    <i class="fas fa-reply mr-2 text-emerald-400"></i>Your Response
                </h3>
            </div>
            <div class="p-6">
                <form method="post" class="space-y-6">
                    <!-- Status Selection -->
                    <div>
                        <label class="block text-sm font-medium text-emerald-400 mb-2">Update Status *</label>
                        <div class="grid grid-cols-2 gap-2">
                            @foreach (var status in new[] { 
                                MessManagement.Models.SuggestionStatus.UnderReview,
                                MessManagement.Models.SuggestionStatus.Resolved,
                                MessManagement.Models.SuggestionStatus.Implemented,
                                MessManagement.Models.SuggestionStatus.Rejected
                            })
                            {
                                <label class="relative cursor-pointer">
                                    <input type="radio" name="Input.Status" value="@status" 
                                           class="peer sr-only" @(Model.Input.Status == status ? "checked" : "") />
                                    <div class="p-3 rounded-xl border border-white/20 bg-white/5 peer-checked:@GetStatusBg(status) hover:bg-white/10 transition-all text-center">
                                        <i class="fas @GetStatusIcon(status) mb-1"></i>
                                        <p class="text-white text-sm">@status</p>
                                    </div>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="Input.Status" class="text-red-400 text-sm"></span>
                    </div>

                    <!-- Response Message -->
                    <div>
                        <label asp-for="Input.AdminResponse" class="block text-sm font-medium text-emerald-400 mb-2">Response Message *</label>
                        <textarea asp-for="Input.AdminResponse" rows="6"
                                  class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent resize-none"
                                  placeholder="Write your response to the member's suggestion..."></textarea>
                        <div class="flex justify-between mt-1">
                            <span asp-validation-for="Input.AdminResponse" class="text-red-400 text-sm"></span>
                            <span class="text-white/40 text-sm"><span id="charCount">0</span>/1000</span>
                        </div>
                    </div>

                    <!-- Quick Response Templates -->
                    <div>
                        <p class="text-white/60 text-sm mb-2">Quick Templates:</p>
                        <div class="flex flex-wrap gap-2">
                            <button type="button" onclick="setTemplate('thank')" 
                                    class="text-xs bg-white/10 hover:bg-white/20 text-white px-3 py-1.5 rounded-lg transition-all">
                                Thank you template
                            </button>
                            <button type="button" onclick="setTemplate('review')" 
                                    class="text-xs bg-white/10 hover:bg-white/20 text-white px-3 py-1.5 rounded-lg transition-all">
                                Under review
                            </button>
                            <button type="button" onclick="setTemplate('implemented')" 
                                    class="text-xs bg-white/10 hover:bg-white/20 text-white px-3 py-1.5 rounded-lg transition-all">
                                Implemented
                            </button>
                            <button type="button" onclick="setTemplate('unable')" 
                                    class="text-xs bg-white/10 hover:bg-white/20 text-white px-3 py-1.5 rounded-lg transition-all">
                                Unable to implement
                            </button>
                        </div>
                    </div>

                    <!-- Submit Buttons -->
                    <div class="flex gap-3 pt-4">
                        <button type="submit" 
                                class="flex-1 bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-600 hover:to-teal-600 text-white px-6 py-3 rounded-xl transition-all shadow-lg font-medium">
                            <i class="fas fa-paper-plane mr-2"></i>Send Response
                        </button>
                        <a href="/Admin/Suggestions" 
                           class="bg-white/10 hover:bg-white/20 text-white px-6 py-3 rounded-xl transition-all border border-white/20">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@functions {
    string GetCategoryColor(MessManagement.Models.SuggestionCategory category)
    {
        return category switch
        {
            MessManagement.Models.SuggestionCategory.Menu => "bg-amber-500/20 text-amber-400 border border-amber-500/30",
            MessManagement.Models.SuggestionCategory.Quality => "bg-blue-500/20 text-blue-400 border border-blue-500/30",
            MessManagement.Models.SuggestionCategory.Complaint => "bg-red-500/20 text-red-400 border border-red-500/30",
            MessManagement.Models.SuggestionCategory.Appreciation => "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30",
            _ => "bg-white/10 text-white/70 border border-white/20"
        };
    }

    string GetCategoryIcon(MessManagement.Models.SuggestionCategory category)
    {
        return category switch
        {
            MessManagement.Models.SuggestionCategory.Menu => "🍽️",
            MessManagement.Models.SuggestionCategory.Quality => "⭐",
            MessManagement.Models.SuggestionCategory.Complaint => "⚠️",
            MessManagement.Models.SuggestionCategory.Appreciation => "❤️",
            _ => "💬"
        };
    }

    string GetStatusColor(MessManagement.Models.SuggestionStatus status)
    {
        return status switch
        {
            MessManagement.Models.SuggestionStatus.Pending => "bg-yellow-500/20 text-yellow-400 border border-yellow-500/30",
            MessManagement.Models.SuggestionStatus.UnderReview => "bg-blue-500/20 text-blue-400 border border-blue-500/30",
            MessManagement.Models.SuggestionStatus.Resolved => "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30",
            MessManagement.Models.SuggestionStatus.Rejected => "bg-red-500/20 text-red-400 border border-red-500/30",
            MessManagement.Models.SuggestionStatus.Implemented => "bg-purple-500/20 text-purple-400 border border-purple-500/30",
            _ => "bg-white/10 text-white/70 border border-white/20"
        };
    }

    string GetStatusBg(MessManagement.Models.SuggestionStatus status)
    {
        return status switch
        {
            MessManagement.Models.SuggestionStatus.UnderReview => "bg-blue-500/20 border-blue-500/50",
            MessManagement.Models.SuggestionStatus.Resolved => "bg-emerald-500/20 border-emerald-500/50",
            MessManagement.Models.SuggestionStatus.Rejected => "bg-red-500/20 border-red-500/50",
            MessManagement.Models.SuggestionStatus.Implemented => "bg-purple-500/20 border-purple-500/50",
            _ => "bg-white/20 border-white/50"
        };
    }

    string GetStatusIcon(MessManagement.Models.SuggestionStatus status)
    {
        return status switch
        {
            MessManagement.Models.SuggestionStatus.UnderReview => "fa-search",
            MessManagement.Models.SuggestionStatus.Resolved => "fa-check-circle",
            MessManagement.Models.SuggestionStatus.Rejected => "fa-times-circle",
            MessManagement.Models.SuggestionStatus.Implemented => "fa-star",
            _ => "fa-question-circle"
        };
    }
}

@section Scripts {
    <script>
        // Character counter
        const textarea = document.querySelector('textarea[name="Input.AdminResponse"]');
        const charCount = document.getElementById('charCount');
        
        textarea.addEventListener('input', function() {
            charCount.textContent = this.value.length;
        });
        charCount.textContent = textarea.value.length;

        // Quick templates
        function setTemplate(type) {
            const templates = {
                'thank': 'Thank you for your valuable feedback! We appreciate you taking the time to share your thoughts with us. Your suggestion has been noted and will help us improve our services.',
                'review': 'Thank you for your suggestion. We are currently reviewing this feedback and will get back to you with an update soon. Your input is valuable to us.',
                'implemented': 'Great news! We are pleased to inform you that your suggestion has been implemented. Thank you for helping us improve our mess services. We appreciate your continued support.',
                'unable': 'Thank you for your suggestion. After careful consideration, we regret to inform you that we are unable to implement this at the moment due to operational constraints. However, we have noted your feedback for future reference.'
            };
            textarea.value = templates[type] || '';
            charCount.textContent = textarea.value.length;
        }
    </script>
}
