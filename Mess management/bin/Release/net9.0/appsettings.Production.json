{
  /*
   * PRODUCTION CONFIGURATION
   * ========================
   * This file contains PLACEHOLDERS for sensitive configuration.
   * 
   * SECURITY: Never commit actual secrets to source control!
   * 
   * In production, these values should be provided via:
   * 1. Environment Variables (preferred for cloud deployments)
   * 2. Azure Key Vault (for Azure deployments)
   * 3. User Secrets (for local development only)
   * 4. CI/CD pipeline secrets
   * 
   * Environment Variable Names:
   * - ConnectionStrings__DefaultConnection
   * - Stripe__SecretKey
   * - Stripe__PublishableKey
   * - Email__SmtpServer
   * - Email__SmtpPort
   * - Email__SenderEmail
   * - Email__SenderPassword
   * - Email__SenderName
   */

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "${CONNECTION_STRING_PLACEHOLDER}"
  },

  "Stripe": {
    "SecretKey": "${STRIPE_SECRET_KEY_PLACEHOLDER}",
    "PublishableKey": "${STRIPE_PUBLISHABLE_KEY_PLACEHOLDER}"
  },

  "Email": {
    "SmtpServer": "${SMTP_SERVER_PLACEHOLDER}",
    "SmtpPort": 587,
    "SenderEmail": "${SENDER_EMAIL_PLACEHOLDER}",
    "SenderPassword": "${SENDER_PASSWORD_PLACEHOLDER}",
    "SenderName": "Mess Management System"
  },

  "Security": {
    "AccountLockout": {
      "MaxFailedAttempts": 5,
      "LockoutDurationMinutes": 15
    },
    "PasswordPolicy": {
      "MinimumLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSpecialCharacter": true,
      "PasswordHistoryCount": 5
    }
  }
}
